$C = "../../Common.ui";
$Sounds = "../../Sounds.ui";

Group {
    LayoutMode: Left;
    Anchor: (Width: 64, Height: 64, Right: 5);

    Button #Button {
        Anchor: (Width: 64, Height: 64);
        Visible: true;
        Style: (
            Sounds: $Sounds.@ButtonsLight,
            Default: (
                Background: "../../Common/SlotDefault.png"
            ),
            Hovered: (
                Background: "../../Common/SlotSelected.png"
            )
        );
        FlexWeight: 1;
        TextTooltipStyle: (MaxWidth: 400);
    }

    Button #ButtonEnabled {
        Anchor: (Width: 64, Height: 64);
        Visible: false;
        Style: (
            Sounds: $Sounds.@ButtonsLight,
            Default: (
                Background: "../../Common/SlotSelected.png"
            ),
            Hovered: (
                Background: "../../Common/SlotDefault.png"
            )
        );
        FlexWeight: 1;
        TextTooltipStyle: (MaxWidth: 400);
    }

    Group {
        LayoutMode: Middle;
        AssetImage #Icon {
            Anchor: (Left: -56, Width: 48, Height: 48);
            AssetPath: "Icons/ItemsGenerated/Bone_Pile.png";
        }
    }

    Group {
        LayoutMode: Middle;
        AssetImage #VariantIcon {
            Anchor: (Top: 30, Left: -26, Width: 21, Height: 24);
            AssetPath: "UI/Custom/Common/VariantIcon.png";
        }
    }
}
