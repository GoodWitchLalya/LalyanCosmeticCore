            }
        }

        Button #CategoryButton {
            Visible: true;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/FaceDetails.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Selected/FaceDetails.png"
                )
            );
        }

        Button #CategoryButtonEnabled {
            Visible: false;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Selected/FaceDetails.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/FaceDetails.png"
                )
            );
        }
    }

    Group #Mouth {
        Padding: (Bottom: 10);

        Group {
            AssetImage #Image {
                Anchor: (Width: 64, Height: 64);
                AssetPath: "UI/Custom/Common/Categories/CategoryIconBackground.png";
            }
        }

        Button #CategoryButton {
            Visible: true;
