$C = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";

Group {
    LayoutMode: Top;

    Group #Undertops {
        Anchor: (Top: 0);
        Padding: (Bottom: 10);

        Group {
            AssetImage #Image {
                Anchor: (Width: 64, Height: 64);
                AssetPath: "UI/Custom/Common/Categories/CategoryIconBackground.png";
            }
        }

        Button #CategoryButton {
            Visible: true;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Undertops.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Selected/Undertops.png"
                )
            );
        }

        Button #CategoryButtonEnabled {
            Visible: false;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Selected/Undertops.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Undertops.png"
                )
            );
        }
    }

    Group #Overtops {
        Anchor: (Top: 0);
        Padding: (Bottom: 10);

