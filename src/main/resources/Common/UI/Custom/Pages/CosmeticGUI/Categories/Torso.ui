                Hovered: (
                    Background: "../../../Common/Categories/Categories/Selected/Overtops.png"
                )
            );
        }

        Button #CategoryButtonEnabled {
            Visible: false;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Selected/Overtops.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Overtops.png"
                )
            );
        }
    }

