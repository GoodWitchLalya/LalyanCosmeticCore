                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Gloves.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Selected/Gloves.png"
                )
            );
        }

        Button #CategoryButtonEnabled {
            Visible: false;
            Anchor: (Width: 83, Height: 64);
            Style: (
                Sounds: $Sounds.@ButtonsLight,
                Default: (
                    Background: "../../../Common/Categories/Categories/Selected/Gloves.png"
                ),
                Hovered: (
                    Background: "../../../Common/Categories/Categories/Gloves.png"
                )
            );
        }
    }

    Group #Tails {
